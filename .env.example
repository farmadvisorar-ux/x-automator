# X Automator Environment Configurations

# Run browser without window (true) or visible (false)
HEADLESS=false

# Browser channel: 'chrome', 'msedge', or leave blank for bundled Playwright chromium
BROWSER_CHANNEL=chrome

# Pacing & Anti-Detection Delays (in seconds)
MIN_DELAY=2.0
MAX_DELAY=5.0

# Keystroke typing speed in milliseconds per character
TYPING_DELAY_MS=35

# Slow motion delay per Playwright action in milliseconds
SLOW_MO_MS=50
